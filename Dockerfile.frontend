# syntax=docker/dockerfile:1.7

# =============================================================================
# Frontend – optimized multi-stage Vite build + nginx
#
# Stages:
#   deps     – npm install (cached when package*.json unchanged)
#   build    – vite production bundle
#   runtime  – nginx:alpine serving static assets only
#
# Build:
#   docker build -f Dockerfile.frontend -t ecomerce-frontend \
#     --build-arg VITE_API_URL=https://api.example.com .
# =============================================================================

ARG NODE_VERSION=20

# -----------------------------------------------------------------------------
# deps: install node_modules in isolation for maximum cache hits
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS deps

WORKDIR /app

# Copy lockfile when present so `npm ci` can be deterministic
COPY frontend/package.json frontend/package-lock.json* ./

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    if [ -f package-lock.json ]; then \
      npm ci --no-audit --no-fund --prefer-offline; \
    else \
      npm install --no-audit --no-fund; \
    fi

# -----------------------------------------------------------------------------
# build: compile static assets (only invalidates on source or env change)
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/package.json frontend/package-lock.json* ./

# Source last so dependency layer stays cached across code edits
COPY frontend/index.html frontend/vite.config.* frontend/jsconfig.* frontend/tsconfig.* ./
COPY frontend/public ./public
COPY frontend/src ./src

ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL \
    NODE_ENV=production

RUN npm run build \
    && rm -rf node_modules

# -----------------------------------------------------------------------------
# runtime: smallest possible static server
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# wget is already in alpine busybox; avoid apk add curl when possible
# Use busybox wget for healthcheck to keep image lean
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Drop default nginx content noise if any residual files remain
RUN rm -f /usr/share/nginx/html/index.html.bak 2>/dev/null || true

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
