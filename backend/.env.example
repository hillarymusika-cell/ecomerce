# Required in production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated. Local default is fine for CI/dev.
# Prod: ecomerce-api.onrender.com,adams-collections.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend origins) – comma-separated absolute origins
# Prod: https://adams-collections.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional; defaults to CORS_ALLOWED_ORIGINS when unset
# CSRF_TRUSTED_ORIGINS=https://adams-collections.onrender.com

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Database – leave empty for SQLite; set for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/ecomerce
DATABASE_URL=
DB_CONN_MAX_AGE=60

# Cache – leave REDIS_URL empty to use LocMem (dev)
# REDIS_URL=redis://127.0.0.1:6379/1
REDIS_URL=
CACHE_KEY_PREFIX=ecomerce
CACHE_DEFAULT_TTL=300
CACHE_PRODUCT_TTL=300
CACHE_PRODUCT_LIST_TTL=120
CACHE_CATEGORY_TTL=1800
CACHE_DASHBOARD_TTL=60

# Throttling (counters live in the cache backend – use Redis in multi-worker deploys)
THROTTLE_ANON=60/minute
THROTTLE_USER=120/minute
THROTTLE_AUTH=10/minute
PAGE_SIZE=20

# Payments
FLW_SECRET_HASH=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Logging / timezone
LOG_LEVEL=INFO
TIME_ZONE=UTC

# Production security (DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
