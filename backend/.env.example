# Required in production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Database – leave empty for SQLite; set for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/ecomerce
DATABASE_URL=
DB_CONN_MAX_AGE=60

# Throttling
THROTTLE_ANON=60/minute
THROTTLE_USER=120/minute
THROTTLE_AUTH=10/minute
PAGE_SIZE=20

# Payments
FLW_SECRET_HASH=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Logging / timezone
LOG_LEVEL=INFO
TIME_ZONE=UTC

# Production security (DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
